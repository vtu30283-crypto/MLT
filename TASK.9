# ============================================================
# TASK 9 - PERCEPTRON AND MLP
# ============================================================

import numpy as np

# ============================================================
# PART 1 - PERCEPTRON LOGIC GATES
# ============================================================

# Step activation function
def step_function(x):
    return 1 if x >= 0 else 0


# Perceptron
def perceptron(inputs, weights, bias):

    weighted_sum = np.dot(
        inputs,
        weights
    ) + bias

    return step_function(
        weighted_sum
    )


# Logic gate
def logic_gate(gate, X, W, b):

    print(
        f"\n{gate} Gate Implementation:"
    )

    for x in X:

        output = perceptron(
            x,
            W,
            b
        )

        print(
            f"Input: {x}, Output: {output}"
        )


# Truth table
X = np.array([
    [0, 0],
    [0, 1],
    [1, 0],
    [1, 1]
])


# AND
AND_W = np.array([1, 1])
AND_b = -1.5

# OR
OR_W = np.array([1, 1])
OR_b = -0.5

# NAND
NAND_W = np.array([-1, -1])
NAND_b = 1.5


# Run logic gates
logic_gate(
    "AND",
    X,
    AND_W,
    AND_b
)

logic_gate(
    "OR",
    X,
    OR_W,
    OR_b
)

logic_gate(
    "NAND",
    X,
    NAND_W,
    NAND_b
)


# ============================================================
# PART 2 - MLP FROM SCRATCH
# ============================================================

# Activation function
def sigmoid(x):

    return 1 / (
        1 + np.exp(-x)
    )


def sigmoid_derivative(x):

    return x * (1 - x)


# ------------------------------------------------------------
# Generate dataset
# ------------------------------------------------------------

np.random.seed(42)

X = np.random.rand(
    100,
    2
)

y = (
    X[:, 0] + X[:, 1] > 1
).astype(int).reshape(
    100,
    1
)

# ------------------------------------------------------------
# Initialize MLP parameters
# ------------------------------------------------------------

input_size = 2
hidden_size = 4
output_size = 1

lr = 0.1

# Weights
W1 = np.random.randn(
    input_size,
    hidden_size
)

b1 = np.zeros(
    (1, hidden_size)
)

W2 = np.random.randn(
    hidden_size,
    output_size
)

b2 = np.zeros(
    (1, output_size)
)

# ------------------------------------------------------------
# Training
# ------------------------------------------------------------

epochs = 1000

for epoch in range(epochs):

    # Forward pass
    hidden_layer = sigmoid(
        np.dot(X, W1) + b1
    )

    output_layer = sigmoid(
        np.dot(hidden_layer, W2) + b2
    )

    # Loss
    loss = np.mean(
        (output_layer - y) ** 2
    )

    # Backpropagation
    output_error = output_layer - y

    output_delta = (
        output_error *
        sigmoid_derivative(output_layer)
    )

    hidden_error = output_delta.dot(
        W2.T
    )

    hidden_delta = (
        hidden_error *
        sigmoid_derivative(hidden_layer)
    )

    # Update weights
    W2 -= (
        hidden_layer.T.dot(output_delta)
        * lr
    )

    b2 -= (
        np.sum(
            output_delta,
            axis=0,
            keepdims=True
        ) * lr
    )

    W1 -= (
        X.T.dot(hidden_delta)
        * lr
    )

    b1 -= (
        np.sum(
            hidden_delta,
            axis=0,
            keepdims=True
        ) * lr
    )

    # Print loss
    if epoch % 100 == 0:

        print(
            f"Epoch {epoch}, Loss: {loss:.4f}"
        )


# ------------------------------------------------------------
# Test model
# ------------------------------------------------------------

predictions = sigmoid(
    np.dot(
        sigmoid(
            np.dot(X, W1) + b1
        ),
        W2
    ) + b2
)

predictions = (
    predictions > 0.5
).astype(int)

accuracy = np.mean(
    predictions == y
) * 100

print(
    f"\nFinal Training Accuracy: {accuracy:.2f}%"
)
